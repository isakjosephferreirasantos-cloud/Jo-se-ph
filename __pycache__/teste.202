<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EU TE AMO</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: radial-gradient(circle at top, #3a0f1e, #12070d 40%, #000 100%);
      color: white;
      font-family: Arial, sans-serif;
      overflow: hidden;
    }

    .container {
      text-align: center;
      position: relative;
      padding: 30px;
    }

    .heart {
      position: relative;
      width: 220px;
      height: 200px;
      margin: 0 auto 25px;
      transform: rotate(-45deg);
      animation: pulse 1.2s infinite ease-in-out;
      filter: drop-shadow(0 0 18px rgba(255, 90, 120, 0.9));
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 110px;
      height: 180px;
      background: linear-gradient(135deg, #ff3d7a, #ff1a5d);
      border-radius: 50px 50px 0 0;
    }

    .heart::before {
      left: 0;
      top: 0;
      transform: rotate(-45deg);
      transform-origin: 0 100%;
    }

    .heart::after {
      left: 110px;
      top: 0;
      transform: rotate(45deg);
      transform-origin: 100% 100%;
    }

    @keyframes pulse {
      0%, 100% {
        transform: rotate(-45deg) scale(1);
      }
      50% {
        transform: rotate(-45deg) scale(1.14);
      }
    }

    h1 {
      font-size: clamp(2rem, 4vw, 4rem);
      letter-spacing: 0.15em;
      margin: 10px 0 12px;
      text-shadow: 0 0 18px rgba(255, 255, 255, 0.4);
    }

    .subtitle {
      font-size: clamp(0.9rem, 1.5vw, 1.4rem);
      letter-spacing: 0.2em;
      color: #ffd7e3;
      min-height: 2em;
      opacity: 0.95;
      text-transform: uppercase;
    }

    .sparkles {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .sparkle {
      position: absolute;
      width: 8px;
      height: 8px;
      background: rgba(255,255,255,0.95);
      border-radius: 50%;
      animation: float 4s ease-in-out infinite;
      box-shadow: 0 0 15px rgba(255,255,255,0.8);
    }

    @keyframes float {
      0% { transform: translateY(0) scale(0.8); opacity: 0.2; }
      50% { transform: translateY(-25px) scale(1.2); opacity: 1; }
      100% { transform: translateY(0) scale(0.8); opacity: 0.2; }
    }
  </style>
</head>
<body>
  <div class="sparkles" id="sparkles"></div>

  <div class="container">
    <div class="heart"></div>
    <h1>EU TE AMO</h1>
    <div class="subtitle" id="phrase">I love you</div>
  </div>

  <script>
    const phrases = [
      "I love you",
      "Te amo",
      "Je t'aime",
      "Ich liebe dich",
      "Ti amo",
      "Love you",
      "Te quiero",
      "Aku mencintaimu",
      "ア 愛してる",
      "사랑해"
    ];

    const phraseEl = document.getElementById("phrase");
    let idx = 0;

    setInterval(() => {
      idx = (idx + 1) % phrases.length;
      phraseEl.textContent = phrases[idx];
    }, 1300);

    const sparkles = document.getElementById("sparkles");

    for (let i = 0; i < 30; i++) {
      const s = document.createElement("span");
      s.className = "sparkle";
      s.style.left = Math.random() * 100 + "%";
      s.style.top = Math.random() * 100 + "%";
      s.style.animationDelay = (Math.random() * 4) + "s";
      s.style.animationDuration = (2 + Math.random() * 3) + "s";
      s.style.opacity = (0.3 + Math.random() * 0.7).toFixed(2);
      sparkles.appendChild(s);
    }
  </script>
</body>
</html>